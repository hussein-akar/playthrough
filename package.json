{
  "name": "playthrough",
  "version": "0.0.0-development",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "description": "Draw the flow of a feature before it exists, list the scenarios you would have put in a spreadsheet, and play each one through the drawing to see where it goes. No dependencies on purpose.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hussein-akar/playthrough.git"
  },
  "homepage": "https://github.com/hussein-akar/playthrough#readme",
  "bugs": {
    "url": "https://github.com/hussein-akar/playthrough/issues"
  },
  "scripts": {
    "start": "node serve.mjs",
    "start:example": "node serve.mjs examples/advanced",
    "test": "node --test test/*.test.mjs",
    "docker:build": "docker build -t playthrough .",
    "docker:run": "docker run --rm -p 8095:8095 -v \"$PWD/specs:/app/specs\" playthrough"
  }
}
