{
  "name": "Payment",
  "description": "Taking the money for a confirmed order. A risky order is held before any method is tried; a card can be declined, a gift card can fall short, and a business customer may be invoiced instead, up to a limit.",
  "inputs": [
    { "name": "method", "type": "enum", "values": ["Card", "PayPal", "GiftCard", "Invoice"] },
    { "name": "amount", "type": "number" },
    { "name": "riskScore", "type": "number" },
    { "name": "cardDeclined", "type": "boolean" },
    { "name": "giftCardBalance", "type": "number" }
  ],
  "state": [
    { "name": "status", "initial": "pending" }
  ],
  "nodes": [
    { "id": "start", "kind": "start", "label": "Payment requested", "x": 80, "y": 320 },
    { "id": "risky", "kind": "decision", "label": "Risky?", "x": 320, "y": 320 },
    { "id": "review", "kind": "action", "label": "Hold for manual review", "x": 580, "y": 620, "set": { "status": "'review'" } },
    { "id": "onhold", "kind": "end", "label": "On hold", "x": 2140, "y": 620 },
    { "id": "method", "kind": "decision", "label": "Method?", "x": 580, "y": 320 },
    { "id": "card", "kind": "action", "label": "Charge the card", "x": 860, "y": 100 },
    { "id": "declined", "kind": "decision", "label": "Declined?", "x": 1120, "y": 100 },
    { "id": "another", "kind": "action", "label": "Ask for another card", "x": 1400, "y": 500, "set": { "status": "'declined'" } },
    { "id": "failed", "kind": "end", "label": "Failed", "x": 2140, "y": 500 },
    { "id": "paypal", "kind": "action", "label": "Redirect to PayPal", "x": 860, "y": 220 },
    { "id": "balance", "kind": "decision", "label": "Enough balance?", "x": 860, "y": 340 },
    { "id": "redeem", "kind": "action", "label": "Redeem the gift card", "x": 1120, "y": 340 },
    { "id": "limit", "kind": "decision", "label": "Under the invoice limit?", "x": 860, "y": 480 },
    { "id": "invoice", "kind": "action", "label": "Issue an invoice", "x": 1120, "y": 480, "set": { "status": "'invoiced'" } },
    { "id": "awaiting", "kind": "end", "label": "Awaiting payment", "x": 2140, "y": 400 },
    { "id": "paid", "kind": "action", "label": "Mark as paid", "x": 1640, "y": 220, "set": { "status": "'paid'" } },
    { "id": "receipt", "kind": "action", "label": "Send a receipt", "x": 1900, "y": 220 },
    { "id": "done", "kind": "end", "label": "Paid", "x": 2140, "y": 220 }
  ],
  "edges": [
    { "id": "e1", "from": "start", "to": "risky" },
    { "id": "e2", "from": "risky", "to": "review", "when": "riskScore >= 80", "color": "warning" },
    { "id": "e3", "from": "risky", "to": "method", "else": true },
    { "id": "e4", "from": "review", "to": "onhold" },
    { "id": "e5", "from": "method", "to": "card", "when": "method == Card" },
    { "id": "e6", "from": "method", "to": "paypal", "when": "method == PayPal" },
    { "id": "e7", "from": "method", "to": "balance", "when": "method == GiftCard" },
    { "id": "e8", "from": "method", "to": "limit", "when": "method == Invoice" },
    { "id": "e9", "from": "card", "to": "declined" },
    { "id": "e10", "from": "declined", "to": "another", "when": "cardDeclined", "color": "failed" },
    { "id": "e11", "from": "declined", "to": "paid", "else": true, "color": "success" },
    { "id": "e12", "from": "another", "to": "failed" },
    { "id": "e13", "from": "paypal", "to": "paid" },
    { "id": "e14", "from": "balance", "to": "redeem", "when": "giftCardBalance >= amount" },
    { "id": "e15", "from": "balance", "to": "another", "else": true, "label": "short", "color": "failed" },
    { "id": "e16", "from": "redeem", "to": "paid" },
    { "id": "e17", "from": "limit", "to": "invoice", "when": "amount <= 500" },
    { "id": "e18", "from": "limit", "to": "review", "else": true, "label": "over the limit", "color": "warning" },
    { "id": "e19", "from": "invoice", "to": "awaiting" },
    { "id": "e20", "from": "paid", "to": "receipt" },
    { "id": "e21", "from": "receipt", "to": "done" }
  ],
  "scenarios": [
    { "id": "s1", "name": "Card goes through", "tags": ["happy path"], "inputs": { "method": "Card", "amount": 60, "riskScore": 10, "cardDeclined": false, "giftCardBalance": 0 },
      "expect": { "actions": ["Charge the card", "Mark as paid", "Send a receipt"], "end": "Paid", "state": { "status": "paid" } } },
    { "id": "s2", "name": "Card declined", "tags": ["declined"], "inputs": { "method": "Card", "amount": 60, "riskScore": 10, "cardDeclined": true, "giftCardBalance": 0 },
      "expect": { "actions": ["Charge the card", "Ask for another card"], "end": "Failed", "state": { "status": "declined" } } },
    { "id": "s3", "name": "PayPal", "tags": ["happy path"], "inputs": { "method": "PayPal", "amount": 60, "riskScore": 5, "cardDeclined": false, "giftCardBalance": 0 },
      "expect": { "actions": ["Redirect to PayPal", "Mark as paid", "Send a receipt"], "end": "Paid", "state": { "status": "paid" } } },
    { "id": "s4", "name": "Gift card covers it", "tags": ["happy path", "gift card"], "inputs": { "method": "GiftCard", "amount": 40, "riskScore": 5, "cardDeclined": false, "giftCardBalance": 50 },
      "expect": { "actions": ["Redeem the gift card", "Mark as paid", "Send a receipt"], "end": "Paid", "state": { "status": "paid" } } },
    { "id": "s5", "name": "Gift card falls short", "tags": ["declined", "gift card"], "inputs": { "method": "GiftCard", "amount": 40, "riskScore": 5, "cardDeclined": false, "giftCardBalance": 20 },
      "expect": { "actions": ["Ask for another card"], "end": "Failed", "state": { "status": "declined" } } },
    { "id": "s6", "name": "Small invoice", "tags": ["happy path", "invoice"], "inputs": { "method": "Invoice", "amount": 300, "riskScore": 10, "cardDeclined": false, "giftCardBalance": 0 },
      "expect": { "actions": ["Issue an invoice"], "end": "Awaiting payment", "state": { "status": "invoiced" } } },
    { "id": "s7", "name": "Big invoice goes to review", "tags": ["review", "invoice"], "inputs": { "method": "Invoice", "amount": 2000, "riskScore": 10, "cardDeclined": false, "giftCardBalance": 0 },
      "expect": { "actions": ["Hold for manual review"], "end": "On hold", "state": { "status": "review" } } },
    { "id": "s8", "name": "High risk score, before any method", "tags": ["review"], "inputs": { "method": "Card", "amount": 60, "riskScore": 95, "cardDeclined": false, "giftCardBalance": 0 },
      "expect": { "actions": ["Hold for manual review"], "end": "On hold", "state": { "status": "review" } } }
  ]
}
