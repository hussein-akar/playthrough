{
  "name": "Order intake",
  "description": "What happens when a task is accepted: which documents get created, which event goes out, and whether a express delivery date is set.",
  "inputs": [
    { "name": "type", "type": "enum", "values": ["Subscription", "Preorder", "Wholesale", "Refund", "Standard"] },
    { "name": "isExpress", "type": "boolean" }
  ],
  "state": [
    { "name": "deliveryDate", "initial": null }
  ],
  "nodes": [
    { "id": "start", "kind": "start", "label": "Order Placed", "x": 80, "y": 220 },
    { "id": "ship", "kind": "action", "label": "Create Shipment", "x": 300, "y": 220 },
    { "id": "express", "kind": "decision", "label": "Express shipping?", "x": 540, "y": 220 },
    { "id": "setdate", "kind": "action", "label": "Set express delivery date", "x": 800, "y": 120, "set": { "deliveryDate": "'today'" } },
    { "id": "keepnull", "kind": "action", "label": "Keep delivery date null", "x": 800, "y": 320 },
    { "id": "invoice", "kind": "action", "label": "Create Invoice", "x": 1060, "y": 220 },
    { "id": "type", "kind": "decision", "label": "Order type?", "x": 1300, "y": 220 },
    { "id": "publish", "kind": "action", "label": "Publish Subscription/Preorder received event", "x": 1580, "y": 120 },
    { "id": "post", "kind": "action", "label": "Trigger Post Processing", "x": 1580, "y": 320 },
    { "id": "done", "kind": "end", "label": "Done", "x": 1840, "y": 220 }
  ],
  "edges": [
    { "id": "e1", "from": "start", "to": "ship" },
    { "id": "e2", "from": "ship", "to": "express" },
    { "id": "e3", "from": "express", "to": "setdate", "when": "isExpress" },
    { "id": "e4", "from": "express", "to": "keepnull", "else": true },
    { "id": "e5", "from": "setdate", "to": "invoice" },
    { "id": "e6", "from": "keepnull", "to": "invoice" },
    { "id": "e7", "from": "invoice", "to": "type" },
    { "id": "e8", "from": "type", "to": "publish", "when": "type in [Subscription, Preorder, Wholesale]" },
    { "id": "e9", "from": "type", "to": "post", "else": true },
    { "id": "e10", "from": "publish", "to": "done" },
    { "id": "e11", "from": "post", "to": "done" }
  ],
  "scenarios": [
    { "id": "s1", "name": "Subscription with express shipping", "tags": ["happy path"], "inputs": { "type": "Subscription", "isExpress": true },
      "expect": { "actions": ["Create Shipment", "Set express delivery date", "Create Invoice", "Publish Subscription/Preorder received event"], "end": "Done", "state": { "deliveryDate": "*" } } },
    { "id": "s2", "name": "Preorder, nothing to rush", "tags": ["happy path"], "inputs": { "type": "Preorder", "isExpress": false },
      "expect": { "actions": ["Create Shipment", "Keep delivery date null", "Create Invoice", "Publish Subscription/Preorder received event"], "end": "Done", "state": { "deliveryDate": "null" } } },
    { "id": "s3", "name": "Refund goes to post processing", "tags": ["happy path", "post processing"], "inputs": { "type": "Refund", "isExpress": true },
      "expect": { "actions": ["Create Shipment", "Set express delivery date", "Create Invoice", "Trigger Post Processing"], "end": "Done", "state": { "deliveryDate": "*" } } },
    { "id": "s4", "name": "Wholesale (someone assumed post processing)", "tags": ["assumption", "post processing"], "inputs": { "type": "Wholesale", "isExpress": false },
      "expect": { "actions": ["Create Shipment", "Keep delivery date null", "Create Invoice", "Trigger Post Processing"], "end": "Done" } }
  ]
}
